{
  "name": "ai-sherpa-dino-classroom",
  "account_id": "82356ad65ade9e0a481f823ca538d437",
  "main": "classroom-entry.mjs",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./.classroom-build",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {"bindings":[{"name":"CLASSROOM_EVENTS","class_name":"ClassroomEvents"},{"name":"GAME_RATE_LIMIT","class_name":"GameRateLimit"}]},
  "migrations": [{"tag":"classroom-events-v1","new_sqlite_classes":["ClassroomEvents"]},{"tag":"classroom-direct-ai-v1","new_sqlite_classes":["GameRateLimit"]}],
  "d1_databases": [
    {"binding":"CLASSROOM_DB","database_name":"ai-sherpa-dino-classroom-data","database_id":"229a7b9d-3e99-4f0c-b1d7-1aa89041beae"},
    {"binding":"ARTWORK_DB","database_name":"ai-sherpa-dino-artworks","database_id":"e23ecc9b-0b76-4cc8-8b8a-39ebc5f4c48a"}
  ],
  "observability": {"enabled":true,"head_sampling_rate":1}
}
